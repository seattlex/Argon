#!/bin/sh
# Argon OS — apply distribution identity inside the image.
set -e

echo "argon: applying branding"

VERSION_STR="$(cat /etc/argon_version 2>/dev/null || echo rolling)"

cat > /etc/os-release <<EOF
PRETTY_NAME="Argon OS ${VERSION_STR}"
NAME="Argon OS"
VERSION_ID="${VERSION_STR}"
VERSION="${VERSION_STR}"
VERSION_CODENAME=argon-rolling
ID=argon
ID_LIKE="kali debian"
HOME_URL="https://github.com/seattlex/argon"
SUPPORT_URL="https://github.com/seattlex/argon/discussions"
BUG_REPORT_URL="https://github.com/seattlex/argon/issues"
ANSI_COLOR="0;38;2;94;129;172"
EOF

# lsb_release reads this on Debian derivatives
if [ -f /etc/lsb-release ] || [ -d /etc ]; then
    cat > /etc/lsb-release <<EOF
DISTRIB_ID=Argon
DISTRIB_RELEASE=${VERSION_STR}
DISTRIB_CODENAME=argon-rolling
DISTRIB_DESCRIPTION="Argon OS ${VERSION_STR}"
EOF
fi

printf 'Argon OS %s \\n \\l\n\n' "${VERSION_STR}" > /etc/issue
printf 'Argon OS %s\n' "${VERSION_STR}" > /etc/issue.net

cat > /etc/motd <<'EOF'

  Argon OS — privacy first, security by default.
  Docs: https://github.com/seattlex/argon/tree/main/docs

EOF

# Default hostname (also set via kernel cmdline for the live session)
echo "argon" > /etc/hostname

# Branding artwork (logo, wallpaper, plymouth logo, calamares images) is
# shipped as ready-made PNGs via includes.chroot — no rendering needed here.
# Just select the plymouth theme once its logo is in place.
if command -v plymouth-set-default-theme >/dev/null 2>&1 \
    && [ -f /usr/share/plymouth/themes/argon/logo.png ]; then
    plymouth-set-default-theme argon || true
fi

# Refresh the icon cache so the Argon app icon resolves immediately.
if command -v gtk-update-icon-cache >/dev/null 2>&1 \
    && [ -d /usr/share/icons/hicolor ]; then
    gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi
