#!/bin/sh
# Argon OS — service policy: hardening services on, listeners off.
set -e

echo "argon: configuring default services"

# Enable a unit but never abort the build if it is missing: package splits
# upstream (e.g. systemd-resolved moving out of the systemd package) should
# be surfaced as a warning, not a hard failure. The packages that provide
# these units are pinned in the package lists.
enable_unit() {
    if systemctl enable "$1" 2>/dev/null; then
        return 0
    fi
    echo "argon: WARNING could not enable $1 (unit not present)" >&2
}

# Enable a systemd *user* unit for every user on the image. PipeWire and
# WirePlumber ship user units, not system units — `systemctl enable` (system
# scope) can't touch them. `--global` writes the enable symlinks under
# /etc/systemd/user/, so the unit starts in every user's session: the live
# `argon` user and any account the installer creates alike. This needs no
# running user session, so it works during the chroot build.
enable_user_unit_global() {
    if systemctl --global enable "$1" 2>/dev/null; then
        return 0
    fi
    echo "argon: WARNING could not --global enable $1 (unit not present)" >&2
}

# --- Enabled by default -------------------------------------------------
enable_unit apparmor.service
enable_unit ufw.service
enable_unit fail2ban.service
# unattended-upgrades runs off the apt-daily timers (its .service is a
# shutdown hook with no [Install] section — do not `enable` it directly)
enable_unit apt-daily.timer
enable_unit apt-daily-upgrade.timer
enable_unit chrony.service || enable_unit chronyd.service
enable_unit systemd-resolved.service
enable_unit NetworkManager.service

# --- Prove Wi-Fi can actually work --------------------------------------
# An enabled, running NetworkManager is NOT evidence that Wi-Fi works.
# NetworkManager does not speak WPA itself: it drives wpa_supplicant over
# the system bus. With the supplicant missing it starts perfectly happily,
# reports every Wi-Fi device as "unavailable", and nm-applet says "device
# not ready" — while the driver, the firmware and wlan0 all look fine and
# dmesg shows no error at all. That shipped, and cost someone a working
# laptop with no diagnosable cause.
#
# wpasupplicant is only a Recommends of network-manager and Argon builds
# with --apt-recommends false, so the package list is the only thing
# holding it in. Assert it here: a green build must mean Wi-Fi associates.
for bin in wpa_supplicant iw rfkill; do
    if ! PATH="/usr/sbin:/sbin:$PATH" command -v "$bin" >/dev/null 2>&1; then
        echo "argon: ERROR '$bin' is missing from the image." >&2
        echo "argon: Wi-Fi cannot work without wpa_supplicant (NetworkManager" >&2
        echo "argon: drives it over D-Bus to do the WPA handshake), and iw/" >&2
        echo "argon: rfkill are how the failure gets diagnosed at all." >&2
        echo "argon: These are Recommends of network-manager and recommends" >&2
        echo "argon: are off — list them in package-lists/argon-base.list.chroot." >&2
        exit 1
    fi
done

# NetworkManager reaches the supplicant by D-Bus *activation*: without this
# service file the binary exists but NM can never start or talk to it, which
# looks identical to the supplicant being absent.
WPA_DBUS=/usr/share/dbus-1/system-services/fi.w1.wpa_supplicant1.service
if [ ! -f "$WPA_DBUS" ]; then
    echo "argon: ERROR $WPA_DBUS is missing — NetworkManager could not" >&2
    echo "argon: D-Bus-activate wpa_supplicant, so Wi-Fi would still fail." >&2
    exit 1
fi

echo "argon: Wi-Fi stack verified (wpa_supplicant + D-Bus activation, iw, rfkill)"
# Bluetooth daemon for the desktop's blueman; local radio only, opens no
# network port, and stays off on hardware without an adapter.
enable_unit bluetooth.service

# --- Audio: PipeWire for every user -------------------------------------
# Belt and suspenders. The pipewire/wireplumber packages already ship these
# user units enabled (their postinst writes the /etc/systemd/user symlinks),
# so normally these calls are idempotent no-ops. They are kept so the intent
# is explicit and survives a future packaging change that stops
# auto-enabling. NOTE: enabling is not what made audio work — the units were
# enabled all along; the fix was installing dbus-user-session (see the
# desktop package list) so the user session bus they connect to exists.
enable_user_unit_global pipewire.socket
enable_user_unit_global pipewire-pulse.socket
enable_user_unit_global wireplumber.service

# Performance (faster/lighter): compressed RAM swap and OOM protection so
# low-memory machines stay responsive instead of freezing.
enable_unit zramswap.service
enable_unit earlyoom.service

# Activate UFW without needing a running daemon in the chroot:
# default deny incoming / allow outgoing, IPv6 included.
if [ -f /etc/ufw/ufw.conf ]; then
    sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
    grep -q '^ENABLED=' /etc/ufw/ufw.conf || echo 'ENABLED=yes' >> /etc/ufw/ufw.conf
fi
if [ -f /etc/default/ufw ]; then
    sed -i 's/^IPV6=.*/IPV6=yes/' /etc/default/ufw
    sed -i 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/' /etc/default/ufw
    sed -i 's/^DEFAULT_OUTPUT_POLICY=.*/DEFAULT_OUTPUT_POLICY="ACCEPT"/' /etc/default/ufw
fi

# systemd-resolved stub resolver: point /etc/resolv.conf at it so every
# application resolves through the DNS-over-TLS path.
ln -sf ../run/systemd/resolve/stub-resolv.conf /etc/resolv.conf

# --- Installed but OFF by default (opt-in listeners) --------------------
# No network service may listen out of the box.
systemctl disable ssh.service 2>/dev/null || true
systemctl disable tor.service 2>/dev/null || true

# Anything that advertises the machine on the LAN is off by default.
systemctl disable avahi-daemon.service 2>/dev/null || true
systemctl disable avahi-daemon.socket 2>/dev/null || true
systemctl disable cups.service 2>/dev/null || true
systemctl disable cups-browsed.service 2>/dev/null || true
# NOTE: bluetooth is deliberately NOT disabled here. It is a local radio,
# not a network-advertised service, and blueman in the tray is useless
# without it; it is enabled above. (An earlier revision both enabled and
# then disabled it here — a no-op that left Bluetooth off.)

# Btrfs snapshots: the first-boot setup service configures snapper on
# installed btrfs systems (it self-skips on ext4/live). grub-btrfsd is
# enabled by the setup service once snapshots exist, so it is not enabled
# here.
enable_unit argon-snapshots-setup.service
# Flathub remote registration on first boot (once the network is up). Adds
# no apps; just lets Argon Software offer Flathub. Self-skips in live.
enable_unit argon-flathub-setup.service

# Faster boot: NetworkManager-wait-online blocks boot until the network is
# up (often many seconds) but nothing on a desktop needs to wait for it.
# ModemManager probes serial devices at boot and is rarely needed.
systemctl disable NetworkManager-wait-online.service 2>/dev/null || true
systemctl disable ModemManager.service 2>/dev/null || true

# chrony replaces systemd-timesyncd (NTS support)
systemctl disable systemd-timesyncd.service 2>/dev/null || true

# --- SSH host keys ------------------------------------------------------
# Never ship pre-generated host keys: every image (and every install made
# from it) would share the same identity. argon-firstboot.service
# regenerates them on first boot of an installed system; live-config does
# the same for live sessions.
rm -f /etc/ssh/ssh_host_*_key /etc/ssh/ssh_host_*_key.pub
enable_unit argon-firstboot.service
