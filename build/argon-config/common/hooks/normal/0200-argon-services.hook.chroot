#!/bin/sh
# Argon OS — service policy: hardening services on, listeners off.
set -e

echo "argon: configuring default services"

# --- Enabled by default -------------------------------------------------
systemctl enable apparmor.service
systemctl enable ufw.service
systemctl enable fail2ban.service
# unattended-upgrades runs off the apt-daily timers (its .service is a
# shutdown hook with no [Install] section — do not `enable` it directly)
systemctl enable apt-daily.timer apt-daily-upgrade.timer
systemctl enable chrony.service 2>/dev/null || systemctl enable chronyd.service
systemctl enable systemd-resolved.service
systemctl enable NetworkManager.service

# Activate UFW without needing a running daemon in the chroot:
# default deny incoming / allow outgoing, IPv6 included.
if [ -f /etc/ufw/ufw.conf ]; then
    sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
    grep -q '^ENABLED=' /etc/ufw/ufw.conf || echo 'ENABLED=yes' >> /etc/ufw/ufw.conf
fi
if [ -f /etc/default/ufw ]; then
    sed -i 's/^IPV6=.*/IPV6=yes/' /etc/default/ufw
    sed -i 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/' /etc/default/ufw
    sed -i 's/^DEFAULT_OUTPUT_POLICY=.*/DEFAULT_OUTPUT_POLICY="ACCEPT"/' /etc/default/ufw
fi

# systemd-resolved stub resolver: point /etc/resolv.conf at it so every
# application resolves through the DNS-over-TLS path.
ln -sf ../run/systemd/resolve/stub-resolv.conf /etc/resolv.conf

# --- Installed but OFF by default (opt-in listeners) --------------------
# No network service may listen out of the box.
systemctl disable ssh.service 2>/dev/null || true
systemctl disable tor.service 2>/dev/null || true

# Anything that advertises the machine on the LAN is off by default.
systemctl disable avahi-daemon.service 2>/dev/null || true
systemctl disable avahi-daemon.socket 2>/dev/null || true
systemctl disable cups.service 2>/dev/null || true
systemctl disable cups-browsed.service 2>/dev/null || true
systemctl disable bluetooth.service 2>/dev/null || true

# chrony replaces systemd-timesyncd (NTS support)
systemctl disable systemd-timesyncd.service 2>/dev/null || true

# --- SSH host keys ------------------------------------------------------
# Never ship pre-generated host keys: every image (and every install made
# from it) would share the same identity. argon-firstboot.service
# regenerates them on first boot of an installed system; live-config does
# the same for live sessions.
rm -f /etc/ssh/ssh_host_*_key /etc/ssh/ssh_host_*_key.pub
systemctl enable argon-firstboot.service
