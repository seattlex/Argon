#!/bin/sh
# Argon OS — create the live user at BUILD time.
#
# This is the reliable way (it is how Kali bakes its 'kali' user): the
# account and a known password exist in the squashfs itself, so logging in
# never depends on live-config or any boot-time service running correctly.
# Previous attempts set the password from a boot script that turned out not
# to run, leaving the account locked and every autologin failing with
# "authentication failure". Baking it here removes that entire dependency.
#
# The live user is removed from INSTALLED systems by the Calamares
# 'removeuser' module (see installer/calamares), which then creates the
# user's real account. So this account only ever lives in the live image.
#
# Live credentials:  username = argon   password = argon

set -e

echo "argon: baking live user 'argon'"

if ! id argon >/dev/null 2>&1; then
    # First regular account, so this becomes UID 1000; do not force the UID
    # (avoids a build failure in the unlikely case it is already taken).
    useradd --create-home --shell /bin/bash --user-group \
        --comment "Argon Live" argon
fi

# A REAL password (not empty/locked) so both autologin and the greeter work
# even if the system's PAM does not permit empty passwords.
echo 'argon:argon' | chpasswd

# Make absolutely sure the account is usable: unlocked, never expiring.
passwd -u argon 2>/dev/null || true
chage -M -1 -E -1 -I -1 argon 2>/dev/null || true

# Admin + hardware access, and the groups PAM autologin may require.
for grp in sudo audio video netdev plugdev cdrom bluetooth scanner \
           lpadmin dialout autologin nopasswdlogin; do
    groupadd -f "$grp" 2>/dev/null || true
    usermod -aG "$grp" argon 2>/dev/null || true
done

# Put the "Install Argon OS" launcher on the live desktop (this is argon's
# own home, so it never leaks to installed users). The menu entry lives in
# /usr/share/applications; both are removed on install by Calamares.
if [ -f /usr/share/applications/install-argon.desktop ]; then
    mkdir -p /home/argon/Desktop
    cp /usr/share/applications/install-argon.desktop /home/argon/Desktop/
    chmod +x /home/argon/Desktop/install-argon.desktop
fi

chown -R argon:argon /home/argon 2>/dev/null || true

# --- Prove the account is actually usable -------------------------------
# "argon / argon didn't work" has been reported more than once, and the
# only way to stop guessing about it is to assert the account state here,
# at build time, instead of discovering it on someone's laptop.
#
# `passwd -S` reports the password status in field 2:
#   P  = usable password set     L = locked     NP = no password
# Anything but P means the login in the docs cannot work, so fail the build
# rather than ship an image nobody can log into.
status="$(passwd -S argon 2>/dev/null | awk '{print $2}')"
case "$status" in
    P) ;;
    *)
        echo "argon: ERROR live user 'argon' has password status '${status:-unknown}'," >&2
        echo "argon: expected 'P' (usable password). The documented" >&2
        echo "argon: argon/argon login would not work — refusing to build." >&2
        exit 1
        ;;
esac

# The login shell must exist, or authentication succeeds and the session
# still dies immediately.
shell="$(getent passwd argon | cut -d: -f7)"
if [ ! -x "$shell" ]; then
    echo "argon: ERROR login shell '$shell' is missing or not executable" >&2
    exit 1
fi

echo "argon: live user 'argon' ready (uid $(id -u argon), password status P, shell $shell)"
