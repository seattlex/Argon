#!/bin/sh
# Argon OS — seed the desktop wallpaper, without ever overriding the user's.
#
# Why this exists: xfdesktop stores the backdrop image per monitor, keyed by
# the RandR *connector* name (Virtual-1, eDP-1, HDMI-1, ...). We can't know
# that name at build time, so the shipped /etc/xdg xfce4-desktop.xml can only
# provide a generic "monitor0" node — which xfdesktop ignores on any machine
# whose real output is named otherwise, leaving the dark solid-colour fallback
# (a black-looking screen). This runs at login and writes the wallpaper to the
# actual connected outputs.
#
# IMPORTANT: it applies the Argon image as a DEFAULT, once. An earlier version
# re-applied it on every login, which silently reset the wallpaper of anyone
# who had picked their own — on every single reboot. So instead:
#
#   * first login (no marker) -> set the Argon wallpaper on every output,
#                                then drop a marker
#   * later logins            -> only fill in outputs that have NO backdrop
#                                at all (e.g. a monitor plugged in since);
#                                never touch one that already has an image
#
# To get the Argon default back, delete the marker and log in again:
#   rm ~/.config/argon/wallpaper-initialized
set -eu

WALL=/usr/share/backgrounds/argon/argon-default.png
[ -f "$WALL" ] || exit 0
CHANNEL=xfce4-desktop
MARKER="${XDG_CONFIG_HOME:-$HOME/.config}/argon/wallpaper-initialized"

# image-style 5 = "Zoomed" (fill the screen, keep aspect).
set_backdrop() {
    base="/backdrop/screen0/monitor$1/workspace0"
    xfconf-query -c "$CHANNEL" -p "$base/last-image" -s "$WALL" 2>/dev/null \
        || xfconf-query -c "$CHANNEL" -p "$base/last-image" -n -t string -s "$WALL" 2>/dev/null || true
    xfconf-query -c "$CHANNEL" -p "$base/image-style" -s 5 2>/dev/null \
        || xfconf-query -c "$CHANNEL" -p "$base/image-style" -n -t int -s 5 2>/dev/null || true
}

# Does this output already have a wallpaper of its own?
has_backdrop() {
    val="$(xfconf-query -c "$CHANNEL" \
            -p "/backdrop/screen0/monitor$1/workspace0/last-image" 2>/dev/null || true)"
    [ -n "$val" ]
}

# Wait for X / xfconfd to come up.
i=0
while [ "$i" -lt 20 ]; do
    xfconf-query -c "$CHANNEL" -l >/dev/null 2>&1 && break
    i=$((i + 1))
    sleep 1
done

if [ -f "$MARKER" ]; then
    # --- Subsequent logins: fill gaps only, never override ----------------
    if command -v xrandr >/dev/null 2>&1; then
        for out in $(xrandr --query 2>/dev/null | awk '/ connected/{print $1}'); do
            has_backdrop "$out" || set_backdrop "$out"
        done
    fi
    exit 0
fi

# --- First login: establish the Argon default -----------------------------
did=0

# Preferred: set the wallpaper for each *connected* RandR output by its real
# name — this is the node xfdesktop actually renders.
if command -v xrandr >/dev/null 2>&1; then
    for out in $(xrandr --query 2>/dev/null | awk '/ connected/{print $1}'); do
        set_backdrop "$out"
        did=1
    done
fi

# Also refresh any backdrop nodes xfdesktop already created (covers the generic
# monitor0 default and any extra workspaces).
for p in $(xfconf-query -c "$CHANNEL" -l 2>/dev/null | grep '/last-image$'); do
    xfconf-query -c "$CHANNEL" -p "$p" -s "$WALL" 2>/dev/null || true
    style="${p%/last-image}/image-style"
    xfconf-query -c "$CHANNEL" -p "$style" -s 5 2>/dev/null \
        || xfconf-query -c "$CHANNEL" -p "$style" -n -t int -s 5 2>/dev/null || true
    did=1
done

# Nothing existed and xrandr was unavailable — seed the generic node.
if [ "$did" -eq 0 ]; then
    set_backdrop 0
fi

# Remember that the default has been applied, so the user's own choice
# survives every future login.
mkdir -p "$(dirname "$MARKER")" 2>/dev/null || true
: > "$MARKER" 2>/dev/null || true

exit 0
