[Unit]
Description=Argon OS live session setup (autologin + password)
Documentation=https://github.com/seattlex/argon
# Live sessions only: an installed system has no live medium, so this
# service is a no-op there even though it stays enabled.
ConditionPathExists=/run/live/medium
# Run after live-config has created the live user, but before anything
# tries to log that user in (display manager or console getty).
After=live-config.service
Before=display-manager.service
Before=getty@tty1.service
Before=lightdm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/argon/argon-live-setup

[Install]
WantedBy=multi-user.target
