#!/bin/sh
# Argon OS — live user setup (live-config hook).
#
# The reliable path is argon-live-setup.service (a systemd unit), because
# live-config does not always execute custom components. This thin wrapper
# just runs the same shared script IF live-config does source it, as an
# extra (idempotent) chance to get autologin ready as early as possible.
#
# It is run in a subshell (not sourced logic), so its exit never affects
# live-config's own run.

if [ -x /usr/libexec/argon/argon-live-setup ]; then
    /usr/libexec/argon/argon-live-setup >/dev/null 2>&1 || true
fi
