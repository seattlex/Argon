#!/bin/sh
# Argon OS — live session user setup.
#
# live-config runs the scripts in this directory during boot of the LIVE
# image only (an installed system never executes them). By default the
# autologin live user has no usable password, so the moment any
# authentication prompt appears there is no way past it — "password
# incorrect" for everything. Give the live user a known password so the
# live session is usable end to end.
#
# This is the LIVE demo account only. Installed systems create their own
# user, with the password chosen in the installer, and never touch this.
#
# Live credentials:  username = argon   password = argon
#
# NOTE: deliberately no `set -e`. live-config may *source* these components,
# and a stray non-zero exit would then abort the rest of live-config's boot
# setup. Every step below is guarded instead.

DEFAULT_USER="argon"
LIVE_PASSWORD="argon"

# Determine the live username: prefer live-config's exported value, then the
# kernel command line (username=/live-config.username=), then the default.
_user="${LIVE_USERNAME:-}"
if [ -z "$_user" ] && [ -r /proc/cmdline ]; then
    _cmdline="$(cat /proc/cmdline 2>/dev/null)"
    for _p in $_cmdline; do
        case "$_p" in
            live-config.username=*) _user="${_p#live-config.username=}" ;;
            username=*)             _user="${_p#username=}" ;;
        esac
    done
fi
[ -n "$_user" ] || _user="$DEFAULT_USER"

# Set the password if the user exists (this component sorts after
# user-setup, which creates it). Try the resolved user and, as a fallback,
# the default name, so a mismatch can't leave the account passwordless.
for _u in "$_user" "$DEFAULT_USER"; do
    if id "$_u" >/dev/null 2>&1; then
        if echo "${_u}:${LIVE_PASSWORD}" | chpasswd 2>/dev/null; then
            echo "argon: live user '${_u}' password set"
            break
        fi
    fi
done

: # always succeed

