# Argon OS — XFCE desktop variant
# Recommends are globally disabled (--apt-recommends false), so everything
# the desktop needs must be listed explicitly.

## Display server & session
xorg
xserver-xorg-input-libinput
xserver-xorg-video-all
lightdm
lightdm-gtk-greeter
light-locker
dbus-x11
polkitd
pkexec
mate-polkit

## XFCE core
xfce4
xfce4-terminal
xfce4-power-manager
xfce4-notifyd
xfce4-screenshooter
xfce4-taskmanager
xfce4-whiskermenu-plugin
xfce4-pulseaudio-plugin
thunar
thunar-archive-plugin
mousepad
ristretto
xarchiver

## Theming (dark, minimal, Nordic)
arc-theme
papirus-icon-theme
fonts-noto-core
fonts-noto-mono
fonts-firacode
librsvg2-bin

## Applications
firefox-esr
network-manager-gnome
pavucontrol
pipewire
pipewire-pulse
wireplumber
gvfs
gvfs-backends
xdg-user-dirs
xdg-utils

## fail2ban systemd backend (recommends are off)
python3-systemd

## Runtime for Argon's own apps (argon-apps.deb via packages.chroot)
python3-gi
gir1.2-gtk-3.0

## Media & codecs — play common audio/video out of the box + thumbnails
ffmpeg
gstreamer1.0-plugins-good
gstreamer1.0-plugins-bad
gstreamer1.0-plugins-ugly
gstreamer1.0-libav
# (hardware VA-API accel: add gstreamer1.0-va once confirmed in the archive;
#  gstreamer1.0-vaapi was dropped from Debian/Kali. Software decode via the
#  plugins above already plays everything.)
tumbler
tumbler-plugins-extra
ffmpegthumbnailer
parole
fonts-noto-color-emoji
fonts-liberation2
fonts-dejavu

## Desktop polish — clipboard manager, night-light filter
xfce4-clipman-plugin
redshift-gtk

## Faster & lighter — compressed RAM swap + OOM protection on low-memory boxes
zram-tools
earlyoom

## More default apps — calculator, disk usage, PDF viewer
galculator
baobab
atril

## Installer (live session only)
calamares
# unsquashfs — Calamares' unpackfs step unpacks the live filesystem.squashfs
# onto the target with this. Without it the install fails immediately with
# "Failed to find unsquashfs".
squashfs-tools
# Boot loader for the INSTALLED system. Calamares' grubcfg/bootloader steps
# run grub-install + update-grub in the target, so these must be present in
# the image. The -bin variants (not the grub-pc/grub-efi metapackages) are
# used deliberately: they carry the platform modules without the interactive
# "install to which disk?" debconf prompt that would stall the chroot build.
grub-common
grub2-common
grub-pc-bin
grub-efi-amd64-bin
efibootmgr
os-prober
