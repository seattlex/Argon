#!/bin/sh
# Argon OS — live-build configuration
#
# This script is invoked by `lb config` (via the auto/ mechanism) and must be
# run from the build/ directory on a Kali rolling system (or container) with
# Kali's live-build installed, since Kali patches live-build to understand
# the kali-rolling distribution.
#
# Environment knobs:
#   ARGON_VARIANT   desktop variant to build (default: xfce)
#   ARGON_MIRROR    Kali mirror to build against (default: http://http.kali.org/kali)
#   ARGON_VERSION   version string embedded in the image name (default: rolling)

set -e

ARGON_VARIANT="${ARGON_VARIANT:-xfce}"
ARGON_MIRROR="${ARGON_MIRROR:-http://http.kali.org/kali}"
ARGON_VERSION="${ARGON_VERSION:-rolling}"

# Reproducibility: pin all timestamps inside the image to the last commit date
# when building from git, unless the caller already set SOURCE_DATE_EPOCH.
if [ -z "${SOURCE_DATE_EPOCH:-}" ] && command -v git >/dev/null 2>&1 \
    && git rev-parse --git-dir >/dev/null 2>&1; then
    SOURCE_DATE_EPOCH="$(git log -1 --format=%ct 2>/dev/null || date +%s)"
    export SOURCE_DATE_EPOCH
fi

# --cache-packages false: live-build's package cache (default on) keeps a
# second copy of every downloaded .deb under build/cache/packages/, purely
# so a *later* build can skip re-downloading. scripts/build-iso.sh runs
# `lb clean --purge` before every single build, local or CI, so that reuse
# never happens here — the cache is pure disk waste, doubling how much of
# the package set sits on disk during the build. Harmless to disable for
# every variant; it became load-bearing for the Security Edition, whose
# kali-linux-default package set is large enough that the duplication was
# enough to exhaust a GitHub-hosted runner's disk mid-build (the job died
# silently, consistent with the runner process itself being OOM/disk killed
# rather than a normal build error).
lb config noauto \
    --distribution kali-rolling \
    --debian-installer none \
    --archive-areas "main contrib non-free non-free-firmware" \
    --mirror-bootstrap "$ARGON_MIRROR" \
    --mirror-binary "$ARGON_MIRROR" \
    --mirror-chroot "$ARGON_MIRROR" \
    --keyring-packages kali-archive-keyring \
    --security false \
    --updates false \
    --backports false \
    --apt-recommends false \
    --binary-images iso-hybrid \
    --bootloaders "grub-efi syslinux" \
    --iso-application "Argon OS" \
    --iso-publisher "The Argon Project; https://github.com/seattlex/argon" \
    --iso-volume "Argon $ARGON_VERSION" \
    --image-name "argon-$ARGON_VERSION-$ARGON_VARIANT" \
    --linux-flavours "$(dpkg --print-architecture | sed 's/^i386$/686-pae/;s/^arm64$/arm64/;s/^amd64$/amd64/')" \
    --bootappend-live "boot=live components quiet splash hostname=argon live-config.hostname=argon apparmor=1 security=apparmor" \
    --memtest none \
    --zsync false \
    --cache-packages false \
    "$@"
