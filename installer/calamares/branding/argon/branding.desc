# Argon OS — Calamares branding
---
componentName: argon

welcomeStyleCalamares: false
welcomeExpandingLogo: true

windowExpanding: normal
windowSize: 900px,600px
windowPlacement: center

strings:
    productName:         "Argon OS"
    shortProductName:    "Argon"
    version:             "rolling"
    shortVersion:        "rolling"
    versionedName:       "Argon OS rolling"
    shortVersionedName:  "Argon rolling"
    bootloaderEntryName: "Argon"
    productUrl:          "https://github.com/seattlex/argon"
