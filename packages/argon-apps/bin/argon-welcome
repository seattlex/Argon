#!/usr/bin/python3
# Argon Welcome — first-boot greeter for Argon OS.
#
# Shown at first login (autostart). Gives newcomers the four things they
# actually need: install the system (live session), get software, see what
# the privacy defaults do, and find the documentation. No wizard, no
# nagging — one window, and a checkbox to never see it again.
#
# Invoked with --autostart it exits silently if the user disabled it.

import os
import shutil
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib  # noqa: E402

APP_ID = "org.argon.Welcome"
DOCS_URL = "https://github.com/seattlex/argon/tree/main/docs"
PROJECT_URL = "https://github.com/seattlex/argon"
DISABLE_MARKER = os.path.join(
    GLib.get_user_config_dir(), "argon", "welcome-disabled")

PRIVACY_DEFAULTS = [
    ("Zero telemetry", "Nothing on Argon reports anything, to anyone."),
    ("Firewall on", "All incoming connections are blocked by default."),
    ("Encrypted DNS", "Lookups go over TLS to Quad9 — your ISP can't read them."),
    ("Wi-Fi privacy", "Your hardware address is randomized while scanning."),
    ("Hardened Firefox", "Tracking protection strict, telemetry off, uBlock Origin."),
    ("Automatic updates", "Security fixes install themselves; reboots are never forced."),
    ("App confinement", "AppArmor restricts what programs can touch."),
    ("Authenticated time", "Even the clock is synced over an authenticated channel."),
]


def is_live_session():
    return os.path.isdir("/run/live/medium")


def installer_available():
    return shutil.which("calamares") is not None


class WelcomeWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Welcome to Argon OS")
        self.set_default_size(680, 560)
        self.set_position(Gtk.WindowPosition.CENTER)

        header = Gtk.HeaderBar(show_close_button=True, title="Welcome")
        self.set_titlebar(header)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        content.set_margin_top(32)
        content.set_margin_bottom(24)
        content.set_margin_start(48)
        content.set_margin_end(48)

        logo = Gtk.Image.new_from_icon_name("argon", Gtk.IconSize.DIALOG)
        logo.set_pixel_size(96)
        content.pack_start(logo, False, False, 0)

        title = Gtk.Label()
        title.set_markup("<span size='xx-large' weight='bold'>Welcome to Argon OS</span>")
        content.pack_start(title, False, False, 0)

        subtitle = Gtk.Label(
            label="Privacy first. Security by default.\n"
                  "Everything is already configured — here's where to start.")
        subtitle.set_justify(Gtk.Justification.CENTER)
        subtitle.get_style_context().add_class("dim-label")
        content.pack_start(subtitle, False, False, 0)

        grid = Gtk.Grid(column_spacing=12, row_spacing=12,
                        column_homogeneous=True, halign=Gtk.Align.FILL)

        buttons = []
        if is_live_session() and installer_available():
            btn = self._action_button(
                "drive-harddisk", "Install Argon OS",
                "Put Argon on this computer (your USB stick stays bootable)",
                self._launch_installer)
            btn.get_style_context().add_class("suggested-action")
            buttons.append(btn)

        buttons.append(self._action_button(
            "system-software-install", "Get Software",
            "Browse and install curated apps — no terminal needed",
            lambda _b: self._spawn(["argon-software"])))
        buttons.append(self._action_button(
            "security-high", "Your Privacy Defaults",
            "See what Argon already protects you from",
            self._show_privacy))
        buttons.append(self._action_button(
            "help-browser", "Documentation",
            "Guides for installing, hardening and daily use",
            lambda _b: self._open_url(DOCS_URL)))
        buttons.append(self._action_button(
            "system-users", "Community & Source Code",
            "Argon is free software — see how it's built, join in",
            lambda _b: self._open_url(PROJECT_URL)))

        for i, btn in enumerate(buttons):
            grid.attach(btn, i % 2, i // 2, 1, 1)
        # A lone last button spans both columns
        if len(buttons) % 2 == 1:
            grid.remove(buttons[-1])
            grid.attach(buttons[-1], 0, (len(buttons) - 1) // 2, 2, 1)

        content.pack_start(grid, False, False, 6)
        scroll.add(content)
        outer.pack_start(scroll, True, True, 0)

        outer.pack_start(Gtk.Separator(), False, False, 0)
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        footer.set_margin_top(8)
        footer.set_margin_bottom(8)
        footer.set_margin_start(16)
        footer.set_margin_end(16)
        check = Gtk.CheckButton(label="Show this window when I log in")
        check.set_active(not os.path.exists(DISABLE_MARKER))
        check.connect("toggled", self._toggle_autostart)
        footer.pack_start(check, False, False, 0)
        outer.pack_start(footer, False, False, 0)

        self.add(outer)
        self.show_all()

    def _action_button(self, icon, label, tooltip, callback):
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DND)
        text = Gtk.Label(label=label, xalign=0)
        box.pack_start(img, False, False, 4)
        box.pack_start(text, True, True, 0)
        btn = Gtk.Button()
        btn.add(box)
        btn.set_tooltip_text(tooltip)
        btn.set_size_request(-1, 56)
        btn.connect("clicked", callback)
        return btn

    def _spawn(self, argv):
        try:
            subprocess.Popen(argv)
        except OSError as exc:
            self._error("Could not start {}".format(argv[0]), str(exc))

    def _launch_installer(self, _btn):
        # Calamares needs root; its desktop entry uses pkexec
        self._spawn(["sh", "-c", "pkexec calamares || calamares"])

    def _open_url(self, url):
        Gtk.show_uri_on_window(self, url, Gtk.get_current_event_time())

    def _show_privacy(self, _btn):
        dialog = Gtk.Dialog(title="Your privacy defaults", transient_for=self,
                            modal=True)
        dialog.add_button("Close", Gtk.ResponseType.CLOSE)
        box = dialog.get_content_area()
        box.set_spacing(8)
        box.set_margin_top(16)
        box.set_margin_bottom(16)
        box.set_margin_start(20)
        box.set_margin_end(20)
        intro = Gtk.Label(
            label="All of this is already active — nothing to set up.", xalign=0)
        intro.get_style_context().add_class("dim-label")
        box.pack_start(intro, False, False, 4)
        for name, desc in PRIVACY_DEFAULTS:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            tick = Gtk.Image.new_from_icon_name(
                "emblem-ok-symbolic", Gtk.IconSize.BUTTON)
            label = Gtk.Label(xalign=0)
            label.set_markup("<b>{}</b> — {}".format(
                GLib.markup_escape_text(name), GLib.markup_escape_text(desc)))
            label.set_line_wrap(True)
            row.pack_start(tick, False, False, 0)
            row.pack_start(label, True, True, 0)
            box.pack_start(row, False, False, 2)
        dialog.show_all()
        dialog.run()
        dialog.destroy()

    def _toggle_autostart(self, check):
        if check.get_active():
            try:
                os.remove(DISABLE_MARKER)
            except FileNotFoundError:
                pass
        else:
            os.makedirs(os.path.dirname(DISABLE_MARKER), exist_ok=True)
            with open(DISABLE_MARKER, "w", encoding="utf-8") as f:
                f.write("Remove this file to re-enable the welcome window.\n")

    def _error(self, text, secondary):
        dialog = Gtk.MessageDialog(
            transient_for=self, message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.CLOSE, text=text, secondary_text=secondary)
        dialog.run()
        dialog.destroy()


class WelcomeApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        win = self.get_active_window()
        if win is None:
            win = WelcomeWindow(self)
        win.present()


if __name__ == "__main__":
    args = sys.argv[:]
    if "--autostart" in args:
        args.remove("--autostart")
        if os.path.exists(DISABLE_MARKER):
            sys.exit(0)
    sys.exit(WelcomeApp().run(args))
