#!/bin/sh
# Argon Virtual Audio — Voicemeeter-style virtual audio cables for PipeWire.
#
# Voicemeeter's core trick is "virtual cables": software audio devices you
# can route apps into and out of. PipeWire (which Argon ships) does this
# natively — this tool just sets it up for you.
#
# Enabling creates two virtual sinks. Each virtual sink:
#   * appears as an OUTPUT device apps can play into
#     ("Argon Virtual Cable A" / "…B")
#   * exposes a MONITOR that appears as an INPUT device other apps can
#     record from (e.g. select it as a microphone in a call or OBS)
#
# Combine with qpwgraph (visual routing) and EasyEffects (EQ/compression)
# for a full Voicemeeter-style mixer. All of it is per-user; nothing here
# touches the system configuration or needs root.
#
# Usage:
#   argon-virtual-audio enable [N]   create N cables (default 2, max 8)
#   argon-virtual-audio disable      remove the cables
#   argon-virtual-audio status       show whether cables are active

set -eu

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/pipewire/pipewire.conf.d"
CONF_FILE="$CONF_DIR/90-argon-virtual-audio.conf"

die() { echo "argon-virtual-audio: $*" >&2; exit 1; }

reload_pipewire() {
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user restart pipewire.service pipewire-pulse.service \
            wireplumber.service 2>/dev/null && return 0
    fi
    echo "Could not restart PipeWire automatically." >&2
    echo "Log out and back in (or run: systemctl --user restart pipewire) to apply." >&2
}

cmd_enable() {
    count="${1:-2}"
    case "$count" in
        ''|*[!0-9]*) die "cable count must be a number" ;;
    esac
    if [ "$count" -lt 1 ] || [ "$count" -gt 8 ]; then
        die "cable count must be 1-8"
    fi

    command -v pipewire >/dev/null 2>&1 || die "PipeWire is not installed"

    letters="ABCDEFGH"

    mkdir -p "$CONF_DIR"
    {
        echo "# Generated by argon-virtual-audio. Edit with the tool, not by hand."
        echo "context.objects = ["
        i=1
        while [ "$i" -le "$count" ]; do
            letter=$(printf '%s' "$letters" | cut -c "$i")  # 1->A, 2->B, ...
            cat <<EOF
    { factory = adapter
        args = {
            factory.name              = support.null-audio-sink
            node.name                 = "argon_cable_${letter}"
            node.description          = "Argon Virtual Cable ${letter}"
            media.class               = Audio/Sink
            monitor.channel-volumes   = true
            monitor.passthrough       = true
            audio.position            = [ FL FR ]
            node.virtual              = false
        }
    }
EOF
            i=$((i + 1))
        done
        echo "]"
    } > "$CONF_FILE"

    reload_pipewire
    echo "Created $count virtual cable(s). Open qpwgraph to route them, or pick"
    echo "\"Argon Virtual Cable A\" as an output/input in your apps and sound settings."
}

cmd_disable() {
    if [ -f "$CONF_FILE" ]; then
        rm -f "$CONF_FILE"
        reload_pipewire
        echo "Removed Argon virtual cables."
    else
        echo "No Argon virtual cables were configured."
    fi
}

cmd_status() {
    if [ -f "$CONF_FILE" ]; then
        echo "Virtual cables: configured ($CONF_FILE)"
        if command -v pw-cli >/dev/null 2>&1; then
            echo "Active PipeWire nodes:"
            pw-cli ls Node 2>/dev/null | grep -i "argon_cable" || \
                echo "  (none live yet — restart PipeWire or re-log in)"
        fi
    else
        echo "Virtual cables: not configured"
    fi
}

action="${1:-}"
if [ $# -gt 0 ]; then
    shift
fi
case "$action" in
    enable)  cmd_enable "$@" ;;
    disable) cmd_disable ;;
    status)  cmd_status ;;
    *)
        echo "Usage: argon-virtual-audio {enable [N] | disable | status}" >&2
        exit 2
        ;;
esac
