#!/usr/bin/make -f
%:
	dh $@

# The autostart entry uses a different name than the menu entry so the
# --autostart flag stays out of the app menu.
override_dh_install:
	dh_install
	install -D -m 0644 data/argon-welcome-autostart.desktop \
	  debian/argon-apps/etc/xdg/autostart/argon-welcome.desktop

execute_after_dh_fixperms:
	chmod 0755 debian/argon-apps/usr/bin/argon-software
	chmod 0755 debian/argon-apps/usr/bin/argon-welcome
	chmod 0755 debian/argon-apps/usr/bin/argon-virtual-audio
	chmod 0755 debian/argon-apps/usr/libexec/argon/argon-pkg-helper
