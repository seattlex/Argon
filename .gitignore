# live-build working tree (assembled/generated in build/)
build/config/
build/cache/
build/chroot/
build/binary/
build/local/
build/.build/
build/build.log
build/chroot.files
build/chroot.packages*
build/live-image-*
build/argon-*.iso*

# Build outputs
iso/*.iso
iso/*.sha256
iso/*.sig
iso/*.packages
iso/*.log

# Debian package build artifacts (any package under packages/)
packages/*.deb
packages/*.changes
packages/*.buildinfo
packages/*.build
packages/*.dsc
packages/*.tar.*
packages/dist/
packages/*/debian/.debhelper/
packages/*/debian/files
packages/*/debian/debhelper-build-stamp
packages/*/debian/*.substvars
packages/*/debian/*.debhelper.log
# debhelper staging dirs: any dir under debian/ that isn't tracked source.
# These match the binary package build trees (debian/<pkg>/).
packages/argon-meta/debian/argon-core/
packages/argon-meta/debian/argon-desktop-xfce/
packages/argon-meta/debian/argon-privacy-tools/
packages/argon-meta/debian/argon-dev-tools/
packages/argon-apps/debian/argon-apps/

# reprepro generated state (only conf/ is versioned)
packages/repo/db/
packages/repo/dists/
packages/repo/pool/
packages/repo/lists/

# Editors / OS noise
*~
*.swp
.DS_Store
